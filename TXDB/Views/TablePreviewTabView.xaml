<UserControl x:Class="TXDB.Views.TablePreviewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tx="clr-namespace:TX.WpfUI.Controls;assembly=TX.WpfUI">
    <Grid Background="{DynamicResource TX.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TX.Brush.Surface}"
                BorderBrush="{DynamicResource TX.Brush.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TableNameText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TX.Brush.TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <tx:TXButton Content="刷新"
                                 ButtonSize="Small"
                                 MinWidth="68"
                                 Click="RefreshButton_Click"
                                 Margin="0,0,6,0" />
                    <tx:TXButton Content="导出"
                                 ButtonSize="Small"
                                 MinWidth="68"
                                 Click="ExportButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <tx:TXDataGrid x:Name="ResultGrid"
                       Grid.Row="1"
                       Margin="10"
                       AutoGenerateColumns="True"
                       IsReadOnly="True"
                       Density="Compact"
                       EnableRowVirtualization="True"
                       EnableColumnVirtualization="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.CanContentScroll="True"
                       ScrollViewer.IsDeferredScrollingEnabled="False"
                       CanUserSortColumns="False"
                       CurrentCellChanged="ResultGrid_CurrentCellChanged"
                       SelectedCellsChanged="ResultGrid_SelectedCellsChanged"
                       GridLinesVisibility="Horizontal"
                       HeadersVisibility="Column" />

        <tx:TXPagination x:Name="PaginationControl"
                         Grid.Row="2"
                         Margin="10,0,10,4"
                         DisplayPageCount="5"
                         IsTotalVisible="True"
                         IsPageSizeSelectorVisible="True" />

        <Border Grid.Row="3"
                Background="{DynamicResource TX.Brush.Surface}"
                BorderBrush="{DynamicResource TX.Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                           Text="准备就绪"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FieldText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="16,0,12,0"
                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                           Text=""
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="SelectionText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                           Text="第 0 条 / 共 0 条" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
