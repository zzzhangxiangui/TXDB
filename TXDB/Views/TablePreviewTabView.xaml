<UserControl x:Class="TXDB.Views.TablePreviewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tx="clr-namespace:TX.WpfUI.Controls;assembly=TX.WpfUI"
             xmlns:views="clr-namespace:TXDB.Views">
    <Grid Background="{DynamicResource TX.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TX.Brush.Surface}"
                BorderBrush="{DynamicResource TX.Brush.Border}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="30">
            <DockPanel Margin="10,0">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TableNameText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TX.Brush.TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420" />
                    <TextBlock x:Name="FilterSummaryText"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TX.Brush.TextSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="320" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <tx:TXButton x:Name="FilterToggleButton"
                                 Content="筛选"
                                 ButtonSize="Small"
                                 MinWidth="88"
                                 Click="FilterToggleButton_Click"
                                 Margin="0,0,6,0">
                        <tx:TXButton.Icon>
                            <tx:TXIcon Source="{StaticResource TX.Icon.搜索}"
                                       Size="15"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                        </tx:TXButton.Icon>
                    </tx:TXButton>
                    <tx:TXButton Content="刷新"
                                 ButtonSize="Small"
                                 MinWidth="76"
                                 Click="RefreshButton_Click"
                                 Margin="0,0,6,0">
                        <tx:TXButton.Icon>
                            <tx:TXIcon Source="{StaticResource TX.Icon.刷新}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                        </tx:TXButton.Icon>
                    </tx:TXButton>
                    <tx:TXButton Content="导出"
                                 ButtonSize="Small"
                                 MinWidth="76"
                                 Click="ExportButton_Click">
                        <tx:TXButton.Icon>
                            <tx:TXIcon Source="{StaticResource TX.Icon.下载}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                        </tx:TXButton.Icon>
                    </tx:TXButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="FilterPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource TX.Brush.Surface}"
                BorderBrush="{DynamicResource TX.Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="10,8"
                Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="False"
                           Margin="0,0,0,8">
                    <TextBlock Text="快速筛选"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TX.Brush.TextPrimary}" />
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                Margin="16,0,0,0">
                        <tx:TXButton Content="添加条件"
                                     ButtonSize="Small"
                                     MinWidth="104"
                                     Click="AddFilterButton_Click"
                                     Margin="0,0,6,0">
                            <tx:TXButton.Icon>
                                <tx:TXIcon Source="{StaticResource TX.Icon.添加}"
                                           Size="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                            </tx:TXButton.Icon>
                        </tx:TXButton>
                        <tx:TXButton Content="应用"
                                     ButtonType="Primary"
                                     ButtonSize="Small"
                                     MinWidth="86"
                                     Click="ApplyFilterButton_Click"
                                     Margin="0,0,6,0">
                            <tx:TXButton.Icon>
                                <tx:TXIcon Source="{StaticResource TX.Icon.搜索}"
                                           Size="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                            </tx:TXButton.Icon>
                        </tx:TXButton>
                        <tx:TXButton Content="清空"
                                     ButtonSize="Small"
                                     MinWidth="82"
                                     Click="ClearFilterButton_Click">
                            <tx:TXButton.Icon>
                                <tx:TXIcon Source="{StaticResource TX.Icon.删除}"
                                           Size="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                            </tx:TXButton.Icon>
                        </tx:TXButton>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="156"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilterConditions, RelativeSource={RelativeSource AncestorType={x:Type views:TablePreviewTabView}}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource TX.Brush.Border}"
                                        BorderThickness="1"
                                        Background="{DynamicResource TX.Brush.Background}"
                                        CornerRadius="4"
                                        Margin="0,0,0,6"
                                        Padding="6">
                                    <Grid MinWidth="720">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />

                                        <tx:TXComboBox Grid.Column="1"
                                                       Height="32"
                                                       Margin="0,0,6,0"
                                                       ItemsSource="{Binding FilterLogicOptions, RelativeSource={RelativeSource AncestorType={x:Type views:TablePreviewTabView}}}"
                                                       SelectedItem="{Binding Logic, Mode=TwoWay}"
                                                       ClearButtonVisibility="Collapsed"
                                                       IsEditable="False"
                                                       IsReadOnly="True"
                                                       MaxDropDownHeight="180" />

                                        <tx:TXComboBox Grid.Column="2"
                                                       Height="32"
                                                       Margin="0,0,6,0"
                                                       ItemsSource="{Binding FilterColumnOptions, RelativeSource={RelativeSource AncestorType={x:Type views:TablePreviewTabView}}}"
                                                       SelectedItem="{Binding ColumnName, Mode=TwoWay}"
                                                       ClearButtonVisibility="Collapsed"
                                                       IsEditable="False"
                                                       IsReadOnly="True"
                                                       MaxDropDownHeight="260"
                                                       ToolTip="{Binding ColumnName}" />

                                        <tx:TXComboBox Grid.Column="3"
                                                       Height="32"
                                                       Margin="0,0,6,0"
                                                       ItemsSource="{Binding FilterOperatorOptions, RelativeSource={RelativeSource AncestorType={x:Type views:TablePreviewTabView}}}"
                                                       DisplayMemberPath="DisplayName"
                                                       SelectedValuePath="OperatorCode"
                                                       SelectedValue="{Binding OperatorCode, Mode=TwoWay}"
                                                       ClearButtonVisibility="Collapsed"
                                                       IsEditable="False"
                                                       IsReadOnly="True"
                                                       MaxDropDownHeight="260" />

                                        <tx:TXTextBox Grid.Column="4"
                                                      Height="32"
                                                      Margin="0,0,6,0"
                                                      Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Watermark="筛选值，列表用逗号分隔"
                                                      VerticalContentAlignment="Center"
                                                      KeyDown="FilterValueBox_KeyDown" />

                                        <tx:TXButton Grid.Column="5"
                                                     Width="36"
                                                     Height="32"
                                                     ButtonSize="Small"
                                                     Padding="0"
                                                     HorizontalAlignment="Center"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Tag="{Binding}"
                                                     Click="RemoveFilterButton_Click">
                                            <tx:TXButton.Icon>
                                                <tx:TXIcon Source="{StaticResource TX.Icon.关闭}"
                                                           Size="13"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type tx:TXButton}}}" />
                                            </tx:TXButton.Icon>
                                        </tx:TXButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <tx:TXDataGrid x:Name="ResultGrid"
                       Grid.Row="2"
                       Margin="10"
                       AutoGenerateColumns="True"
                       IsReadOnly="True"
                       Density="Compact"
                       EnableRowVirtualization="True"
                       EnableColumnVirtualization="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.CanContentScroll="True"
                       ScrollViewer.IsDeferredScrollingEnabled="False"
                       CanUserSortColumns="False"
                       CurrentCellChanged="ResultGrid_CurrentCellChanged"
                       SelectedCellsChanged="ResultGrid_SelectedCellsChanged"
                       GridLinesVisibility="Horizontal"
                       HeadersVisibility="Column" />

        <tx:TXPagination x:Name="PaginationControl"
                         Grid.Row="3"
                         Margin="10,0,10,4"
                         DisplayPageCount="5"
                         IsTotalVisible="True"
                         IsPageSizeSelectorVisible="True" />

        <Border Grid.Row="4"
                Background="{DynamicResource TX.Brush.Surface}"
                BorderBrush="{DynamicResource TX.Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                           Text="准备就绪"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FieldText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="16,0,12,0"
                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                           Text=""
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="SelectionText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                           Text="第 0 条 / 共 0 条" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
