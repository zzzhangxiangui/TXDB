<UserControl x:Class="TXDB.Views.TableStructureTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tx="clr-namespace:TX.WpfUI.Controls;assembly=TX.WpfUI">
    <UserControl.Resources>
        <Style x:Key="StructureButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#646464" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#e5f3ff" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#e5f3ff" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#c0c0c0" /><Setter TargetName="Surface" Property="Background" Value="Transparent" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StructureIcon" TargetType="tx:TXIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="CellEditor" TargetType="TextBox">
            <EventSetter Event="PreviewMouseDoubleClick" Handler="CellEditor_PreviewMouseDoubleClick" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource TX.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource TX.Brush.Surface}" Padding="12,10" BorderBrush="{DynamicResource TX.Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="表结构" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TX.Brush.TextPrimary}" Margin="0,0,0,10" />
                <WrapPanel x:Name="ScopePanel">
                    <TextBlock Text="数据库" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="DatabaseBox" Width="180" Padding="5,3" TextChanged="Definition_TextChanged" Margin="0,0,16,0" />
                    <TextBlock Text="架构" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SchemaBox" Width="130" Padding="5,3" TextChanged="Definition_TextChanged" Margin="0,0,16,0" />
                    <TextBlock Text="表名" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="NameBox" Width="220" Padding="5,3" TextChanged="Definition_TextChanged" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <tx:TXDataGrid x:Name="StructureGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                       Density="Compact" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="All"
                       CanUserSortColumns="False" SelectionChanged="StructureGrid_SelectionChanged" PreviewMouseLeftButtonDown="StructureGrid_PreviewMouseLeftButtonDown"
                       BeginningEdit="StructureGrid_BeginningEdit" PreparingCellForEdit="StructureGrid_PreparingCellForEdit" ItemsSource="{Binding Columns}">
            <tx:TXDataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0078d7" /><Setter Property="Foreground" Value="White" /></Trigger>
                        <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#202020" /></Trigger>
                    </Style.Triggers>
                </Style>
            </tx:TXDataGrid.CellStyle>
            <tx:TXDataGrid.Columns>
                <DataGridTextColumn Header="字段名" Width="180" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" />
                <DataGridTemplateColumn Header="类型" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanEdit}" VerticalContentAlignment="Center" Padding="3,0" BorderThickness="0" Background="White" Foreground="#202020" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="长度 / 精度" Width="115" Binding="{Binding TypeArguments, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" />
                <DataGridTemplateColumn Header="主键" Width="65">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsPrimaryKey, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="允许空" Width="75">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding AllowNull, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAllowNull}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="自增" Width="65">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsIdentity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeIdentity}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="自增属性仅支持在新增字段时设置" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="默认值（SQL 表达式）" Width="180" Binding="{Binding DefaultSql, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" />
                <DataGridTextColumn x:Name="CommentColumn" Header="注释" Width="*" MinWidth="150" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditor}" />
            </tx:TXDataGrid.Columns>
        </tx:TXDataGrid>
        <Border Grid.Row="2" Background="{DynamicResource TX.Brush.Surface}" BorderBrush="{DynamicResource TX.Brush.Border}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="AddButton" Style="{StaticResource StructureButton}" ToolTip="新增字段" Click="AddButton_Click"><tx:TXIcon Style="{StaticResource StructureIcon}" Source="{StaticResource TX.Icon.添加记录}" /></Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource StructureButton}" ToolTip="删除选中字段（提交后生效）" Click="DeleteButton_Click"><tx:TXIcon Style="{StaticResource StructureIcon}" Source="{StaticResource TX.Icon.删除记录}" /></Button>
                    <Button x:Name="SaveButton" Style="{StaticResource StructureButton}" ToolTip="提交表结构" Click="SaveButton_Click"><tx:TXIcon Style="{StaticResource StructureIcon}" Source="{StaticResource TX.Icon.提交更改}" /></Button>
                    <Button x:Name="CancelButton" Style="{StaticResource StructureButton}" ToolTip="取消未提交的结构更改" Click="CancelButton_Click"><tx:TXIcon Style="{StaticResource StructureIcon}" Source="{StaticResource TX.Icon.取消更改}" /></Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource StructureButton}" ToolTip="刷新表结构" Click="RefreshButton_Click"><tx:TXIcon Style="{StaticResource StructureIcon}" Source="{StaticResource TX.Icon.刷新记录}" /></Button>
                </StackPanel>
                <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TX.Brush.TextSecondary}" ToolTip="文本默认值请加单引号，例如 '待处理'；留空表示不设置默认值。" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
