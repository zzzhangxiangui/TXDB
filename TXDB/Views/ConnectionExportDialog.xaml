<Window x:Class="TXDB.Views.ConnectionExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tx="clr-namespace:TX.WpfUI.Controls;assembly=TX.WpfUI"
        Title="导出连接"
        Width="560"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Icon="../Logo.ico"
        Background="{DynamicResource TX.Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 弹窗标题只说明当前操作，具体连接由下方列表选择。 -->
        <TextBlock Grid.Row="0"
                   Text="选择需要导出的连接"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TX.Brush.TextPrimary}" />

        <TextBlock Grid.Row="1"
                   x:Name="SelectedCountText"
                   Margin="0,8,0,12"
                   Foreground="{DynamicResource TX.Brush.TextSecondary}"
                   Text="已选择 0 个连接" />

        <Border Grid.Row="2"
                Background="{DynamicResource TX.Brush.Surface}"
                BorderBrush="{DynamicResource TX.Brush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox x:Name="ConnectionList"
                     BorderThickness="0"
                     Background="{DynamicResource TX.Brush.Surface}"
                     Foreground="{DynamicResource TX.Brush.TextPrimary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Checked="SelectionBox_Changed"
                                      Unchecked="SelectionBox_Changed" />

                            <tx:TXIcon Grid.Column="1"
                                       Source="{StaticResource TX.Icon.数据}"
                                       Size="16"
                                       Foreground="{DynamicResource TX.Brush.Primary}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TX.Brush.TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TX.Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <tx:TXButton Content="全选"
                             Width="78"
                             ButtonSize="Medium"
                             Click="SelectAllButton_Click"
                             Margin="0,0,8,0" />
                <tx:TXButton Content="全不选"
                             Width="82"
                             ButtonSize="Medium"
                             Click="SelectNoneButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <tx:TXButton Content="取消"
                             Width="82"
                             ButtonSize="Medium"
                             Click="CancelButton_Click"
                             Margin="0,0,8,0" />
                <tx:TXButton Content="导出"
                             Width="82"
                             ButtonType="Primary"
                             ButtonSize="Medium"
                             Click="ExportButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
