<Window x:Class="TXDB.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tx="clr-namespace:TX.WpfUI.Controls;assembly=TX.WpfUI"
        Title="数据库连接"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F8FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22">
                    <TextBlock Text="连接信息" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,18" />

                    <TextBlock Text="连接名称" Foreground="#475569" Margin="0,0,0,6" />
                    <tx:TXTextBox x:Name="NameBox" Watermark="例如：本地 SQL Server" Margin="0,0,0,14" />

                    <TextBlock Text="数据库类型" Foreground="#475569" Margin="0,0,0,6" />
                    <tx:TXComboBox x:Name="ProviderBox"
                                   Watermark="选择数据库类型"
                                   DisplayMemberPath="DisplayName"
                                   SelectedValuePath="ProviderType"
                                   Height="32"
                                   MaxDropDownHeight="220"
                                   SelectionChanged="ProviderBox_SelectionChanged"
                                   Margin="0,0,0,14" />

                    <StackPanel x:Name="ServerPanel">
                        <TextBlock Text="服务器地址" Foreground="#475569" Margin="0,0,0,6" />
                        <tx:TXTextBox x:Name="HostBox" Watermark="localhost / IP / 域名" Margin="0,0,0,14" />

                        <TextBlock Text="端口" Foreground="#475569" Margin="0,0,0,6" />
                        <tx:TXTextBox x:Name="PortBox" Watermark="可留空使用默认端口" Margin="0,0,0,14" />

                        <TextBlock Text="数据库/服务名" Foreground="#475569" Margin="0,0,0,6" />
                        <tx:TXTextBox x:Name="DatabaseBox" Watermark="数据库名、服务名或初始目录" Margin="0,0,0,14" />
                    </StackPanel>

                    <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                        <TextBlock Text="数据库文件" Foreground="#475569" Margin="0,0,0,6" />
                        <tx:TXPathPicker x:Name="FilePicker"
                                         Mode="File"
                                         BrowseButtonText="浏览"
                                         IsTextReadOnly="False"
                                         Filter="数据库文件|*.db;*.sqlite;*.sqlite3;*.mdb;*.accdb|所有文件|*.*"
                                         Margin="0,0,0,14" />
                    </StackPanel>

                    <CheckBox x:Name="WindowsAuthBox"
                              Content="使用 Windows 身份验证"
                              Margin="0,0,0,14"
                              Checked="WindowsAuthBox_Changed"
                              Unchecked="WindowsAuthBox_Changed" />

                    <StackPanel x:Name="CredentialPanel">
                        <TextBlock Text="用户名" Foreground="#475569" Margin="0,0,0,6" />
                        <tx:TXTextBox x:Name="UserNameBox" Watermark="登录用户名" Margin="0,0,0,14" />

                        <TextBlock Text="密码" Foreground="#475569" Margin="0,0,0,6" />
                        <tx:TXPasswordBox x:Name="PasswordBox" Watermark="登录密码" Margin="0,0,0,14" />

                        <CheckBox x:Name="SavePasswordBox" Content="保存密码到本机配置" Margin="0,0,0,14" />
                    </StackPanel>

                    <TextBlock Text="完整连接字符串" Foreground="#475569" Margin="0,0,0,6" />
                    <tx:TXTextBox x:Name="RawConnectionBox"
                                  Watermark="可选；填写后优先使用该连接字符串"
                                  Height="68"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="True" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="1" LastChildFill="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left" VerticalAlignment="Center">
                <tx:TXButton Content="测试连接" ButtonSize="Medium" Click="TestButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                <tx:TXButton Content="取消" Width="82" ButtonSize="Medium" Click="CancelButton_Click" Margin="0,0,8,0" />
                <tx:TXButton Content="确定" Width="82" ButtonType="Primary" ButtonSize="Medium" Click="OkButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
